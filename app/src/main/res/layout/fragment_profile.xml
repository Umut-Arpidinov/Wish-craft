<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_layout"
        />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_ava"
        android:layout_width="86dp"
        android:layout_height="86dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/CircleShape"
        tools:src="@drawable/ic_launcher_background"
        />

    <LinearLayout
        android:id="@+id/ll_wishes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/iv_ava"
        app:layout_constraintEnd_toStartOf="@id/ll_followers"
        app:layout_constraintTop_toTopOf="@id/iv_ava"
        app:layout_constraintBottom_toBottomOf="@id/iv_ava"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <TextView
            android:id="@+id/tv_wishes_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="47"
            android:textSize="18sp"
            style="@style/Urbanist14spRegular"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wishes"
            android:textSize="18sp"
            style="@style/Urbanist14spRegular"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_followers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ll_wishes"
        app:layout_constraintEnd_toStartOf="@id/ll_following"
        app:layout_constraintTop_toTopOf="@id/iv_ava"
        app:layout_constraintBottom_toBottomOf="@id/iv_ava"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <TextView
            android:id="@+id/tv_followers_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="24"
            android:textSize="18sp"
            style="@style/Urbanist14spRegular"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Followers"
            android:textSize="18sp"
            style="@style/Urbanist14spRegular"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_following"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ll_followers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_ava"
        app:layout_constraintBottom_toBottomOf="@id/iv_ava"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <TextView
            android:id="@+id/tv_following_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="24"
            android:textSize="18sp"
            style="@style/Urbanist14spRegular"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Following"
            android:textSize="18sp"
            style="@style/Urbanist14spRegular"
            />

    </LinearLayout>

    <TextView
        app:layout_constraintTop_toBottomOf="@id/iv_ava"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/tv_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Madina Akpaeva"
        android:textSize="18sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        style="@style/Urbanist25spBold"
        />

    <TextView
        app:layout_constraintTop_toBottomOf="@id/tv_username"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/tv_my_wishes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Wishes"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        style="@style/Urbanist14spRegular"
        android:textSize="20sp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWishList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_my_wishes"
        tools:listitem="@layout/item_my_wish"
        app:spanCount="2"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="20dp"
        >

    </androidx.recyclerview.widget.RecyclerView>

    <ProgressBar
        android:id="@+id/progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>