<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:orientation="vertical">

    <View
        android:layout_width="90dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@drawable/bottom_sheet_line" />

    <LinearLayout
        style="@style/BottomSheetBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_camera"
            style="@style/LayoutSilverBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_14dp"
            android:layout_marginTop="@dimen/margin_30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/margin_18dp"
                android:layout_weight="9"
                android:paddingHorizontal="@dimen/margin_10dp"
                android:text="Добавить себе"
                android:textAppearance="@style/Urbanist14spSemiBold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_gallery"
            style="@style/LayoutSilverBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_14dp"
            android:layout_marginTop="@dimen/margin_14dp"
            android:layout_marginBottom="@dimen/margin_30dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_10dp"
                android:layout_marginVertical="@dimen/margin_18dp"
                android:layout_weight="9"
                android:text="Поделиться"
                android:textAppearance="@style/Urbanist14spSemiBold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>